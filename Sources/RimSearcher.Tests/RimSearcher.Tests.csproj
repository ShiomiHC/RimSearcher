<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RimSearcher.Core\RimSearcher.Core.csproj" />
    <ProjectReference Include="..\RimSearcher.Cli\RimSearcher.Cli.csproj" />
  </ItemGroup>

  <!--
    导出器整个跑在游戏进程里,是这套代码唯一没有闸的一层 —— 而第八轮盲测里 data_side
    的摩擦单价最高(1.00,是 cli_output 的 1.4 倍)。DataMod 是 net472、这里是 net10.0,
    ProjectReference 引不动;所以只把**不碰 RimWorld 类型的那一个文件**编进来验。
    往这里加文件前先确认它同样不 using RimWorld/Verse,否则会在还原时才炸。
  -->
  <ItemGroup>
    <Compile Include="..\RimSearcher.DataMod\FieldWalk.cs" Link="Exporter\FieldWalk.cs" />
  </ItemGroup>

</Project>