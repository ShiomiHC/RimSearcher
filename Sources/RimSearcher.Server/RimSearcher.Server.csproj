<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>RimSearcher.Server</RootNamespace>
        
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>false</SelfContained>
        <PublishReadyToRun>true</PublishReadyToRun>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

        <!-- PublishSingleFile 与 PublishReadyToRun 都要求 RID，而这里过去一个都没写——
             RID 只活在某个人的命令行 `-r win-x64` 里，仓库本身没有任何记录。换台机器、
             或者忘了带参数，发布就要么直接失败、要么产出个不是单文件的东西，谁也说不清
             上一版正式产物是怎么构建出来的。写进项目，发布命令就不再需要口口相传。
             只做 win-x64：IndexHost 的索引共享依赖 Windows 命名信号量，非 Windows 平台
             本来就走 standalone 降级路径，没有第二个目标平台需要支持。 -->
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>

        <PublishDir>..\Publish\</PublishDir>

        <!-- 只拦「往发布目录拷本项目的符号」这一步，不影响构建输出目录里的 pdb，所以留在无条件组里。
             真正的去符号条件化在 Sources/Directory.Build.props，那里连 Core 一起管。 -->
        <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    </PropertyGroup>

    <!-- 保底。正常路径上符号已经在 Directory.Build.props 里被关掉了，这里防的是 _IsPublishing
         没被置上的发布方式（`msbuild /t:Publish`、`dotnet build /t:Publish`）：那时 pdb 照样生成，
         而 CopyOutputSymbolsToPublishDirectory 只管本项目自己的那份，ProjectReference 带过来的
         Core.pdb 不受它约束——历史上 Sources\Publish\ 里就一直躺着一个 48KB 的 Core.pdb。
         「发布目录一个 pdb 都不留」是硬约束，与其去猜哪个 SDK 开关拦哪一类符号，不如发布完扫一遍。 -->
    <Target Name="StripSymbolsFromPublishDir" AfterTargets="Publish">
        <ItemGroup>
            <_PublishedSymbols Include="$(PublishDir)**\*.pdb" />
        </ItemGroup>
        <Delete Files="@(_PublishedSymbols)" />
    </Target>

    <ItemGroup>
      <ProjectReference Include="..\RimSearcher.Core\RimSearcher.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="RimSearcher.Tests" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Tomlyn" Version="2.10.1" />
    </ItemGroup>

</Project>
