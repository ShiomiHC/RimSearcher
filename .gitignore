# .gitignore for RimSearcher

# Build artifacts
.build/
Publish/
bin/
obj/

# 子代理隔离用的临时 worktree，落在仓库内但不属于仓库
.claude/worktrees/

# IDE settings
.idea/
.vs/
*.user
*.userosscache
*.sln.docstates

# NuGet
packages/
*.nuget.props
*.nuget.targets

# OS generated files
.DS_Store
Thumbs.db

# MCP project specific logs or temp files
*.log
/config.toml
